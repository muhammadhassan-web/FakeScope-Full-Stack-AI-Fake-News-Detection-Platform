# Copy to .env and adjust for your environment
FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-string
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO
MAX_TEXT_LENGTH=10000
MIN_TEXT_LENGTH=20
RATELIMIT_DEFAULT=60 per minute
RATELIMIT_PREDICT=20 per minute
RATELIMIT_VERIFY=10 per minute
RATELIMIT_STORAGE_URI=memory://
WEB_CONCURRENCY=2

# Live fact-checking (/verify) — web search + LLM reasoning over current sources.
# Free keys, no card required: https://app.tavily.com and https://console.groq.com/keys
# Leave blank to disable /verify (it responds 503 instead of failing silently).
TAVILY_API_KEY=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
FACTCHECK_MAX_SOURCES=5
